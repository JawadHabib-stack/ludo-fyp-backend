{
  "info": {
    "name": "Ludo FYP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API of the Ludo FYP backend. Run \"Login demo1\" (or \"Guest login\") first: it saves {{token}} automatically. Socket.IO (gameplay) is tested with a Postman \"Socket.IO\" request: URL http://localhost:3000, header Authorization: Bearer {{token}}, enable acknowledgements, events: match:join / game:roll / game:move with { \"match_id\": ... }."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "player_id",
      "value": ""
    },
    {
      "key": "match_id",
      "value": ""
    },
    {
      "key": "room_code",
      "value": ""
    },
    {
      "key": "invitation_id",
      "value": ""
    },
    {
      "key": "friendship_id",
      "value": ""
    },
    {
      "key": "tournament_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Guest login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/guest",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"postman-device-1\",\n  \"display_name\": \"Postman Guest\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "pm.collectionVariables.set('player_id', pm.response.json().data.player.player_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@ludo.test\",\n  \"password\": \"secret12\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "pm.collectionVariables.set('player_id', pm.response.json().data.player.player_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login demo1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"demo1\",\n  \"password\": \"password123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "pm.collectionVariables.set('player_id', pm.response.json().data.player.player_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login demo2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"demo2\",\n  \"password\": \"password123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().data.token);",
                  "pm.collectionVariables.set('player_id', pm.response.json().data.player.player_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Search needs a registered account.",
      "item": [
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"New Name\"\n}"
            }
          }
        },
        {
          "name": "My match history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/me/matches"
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/search?q=demo"
          }
        },
        {
          "name": "Leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/users/leaderboard",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Friends",
      "description": "Registered users only.",
      "item": [
        {
          "name": "Friend list",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/friends"
          }
        },
        {
          "name": "Requests (received + sent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/friends/requests"
          }
        },
        {
          "name": "Send request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/friends/requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo4\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('friendship_id', pm.response.json().data.friendship_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/friends/requests/{{friendship_id}}",
            "description": "Login as the receiver first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            }
          }
        },
        {
          "name": "Reject request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/friends/requests/{{friendship_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\"\n}"
            }
          }
        },
        {
          "name": "Remove friend",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/friends/4",
            "description": "Last part of the URL = player_id of the friend."
          }
        }
      ]
    },
    {
      "name": "Rule sets & matches",
      "item": [
        {
          "name": "Rule sets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/rule-sets",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create bot match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/matches/bot",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rule_set_id\": 3,\n  \"total_players\": 4,\n  \"game_mode\": \"ffa\",\n  \"difficulty\": \"easy\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('match_id', pm.response.json().data.match_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Match state",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/matches/{{match_id}}"
          }
        },
        {
          "name": "Match moves",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/matches/{{match_id}}/moves"
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "description": "Create / invite / start need a registered account. Anyone can join by code.",
      "item": [
        {
          "name": "Create room (host)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rule_set_id\": 3,\n  \"max_players\": 4,\n  \"game_mode\": \"ffa\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('match_id', pm.response.json().data.match_id);",
                  "pm.collectionVariables.set('room_code', pm.response.json().data.room_code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Room by code",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/rooms/code/{{room_code}}"
          }
        },
        {
          "name": "Join by code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rooms/join",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_code\": \"{{room_code}}\"\n}"
            }
          }
        },
        {
          "name": "Invite friend (host)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rooms/{{match_id}}/invitations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('invitation_id', pm.response.json().data.invitation_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/rooms/invitations"
          }
        },
        {
          "name": "Accept invitation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rooms/invitations/{{invitation_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            }
          }
        },
        {
          "name": "Decline invitation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rooms/invitations/{{invitation_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"decline\"\n}"
            }
          }
        },
        {
          "name": "Leave room",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/rooms/{{match_id}}/leave"
          }
        },
        {
          "name": "Start room (host)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/rooms/{{match_id}}/start",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fill_with_bots\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Tournaments - browse",
      "item": [
        {
          "name": "List open tournaments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tournaments?status=registration",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Details + bracket",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "My tournaments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tournaments/mine"
          }
        },
        {
          "name": "My upcoming matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tournaments/my-matches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('match_id', pm.response.json().data[0].match_id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tournaments - creator",
      "description": "Only the creator of the tournament can use these.",
      "item": [
        {
          "name": "Create tournament",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tournaments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Viva Cup\",\n  \"description\": \"FYP demo\",\n  \"rule_set_id\": 3,\n  \"max_participants\": 4,\n  \"players_per_match\": 2,\n  \"start_time\": \"2026-12-31 18:00:00\",\n  \"round_break_minutes\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('tournament_id', pm.response.json().data.tournament_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit tournament",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tournaments/{{tournament_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Viva Cup 2026\",\n  \"start_time\": \"2026-12-31 19:00:00\"\n}"
            }
          }
        },
        {
          "name": "Remove a player",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/participants/4",
            "description": "Last part = player_id. Only before the start."
          }
        },
        {
          "name": "Start now",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/start"
          }
        },
        {
          "name": "Change match time",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/matches/{{match_id}}/schedule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduled_at\": \"2026-12-31 19:30:00\"\n}"
            }
          }
        },
        {
          "name": "Start match now",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/matches/{{match_id}}/start"
          }
        },
        {
          "name": "Cancel tournament",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Tournaments - players",
      "description": "Registered users. Inviting needs you to be the creator or a participant, and the receiver must be your friend.",
      "item": [
        {
          "name": "Join",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/register"
          }
        },
        {
          "name": "Leave",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/register"
          }
        },
        {
          "name": "Invite a friend",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tournaments/{{tournament_id}}/invitations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_id\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('invitation_id', pm.response.json().data.invitation_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My tournament invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tournaments/invitations"
          }
        },
        {
          "name": "Accept invitation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tournaments/invitations/{{invitation_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"accept\"\n}"
            }
          }
        },
        {
          "name": "Decline invitation",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tournaments/invitations/{{invitation_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"decline\"\n}"
            }
          }
        }
      ]
    }
  ]
}
